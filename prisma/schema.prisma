generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./venturehq.db"
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  color       String // hex accent color used across cards, tags, calendar dots
  status      String // active | back-burner | launching
  description String
  notes       String   @default("") // markdown scratchpad, autosaved
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks     Task[]
  documents Document[]
  contacts  Contact[]
  links     Link[]
  deals     Deal[]
  ledger    LedgerEntry[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  notes       String    @default("")
  priority    String    @default("P2") // P1 | P2 | P3
  status      String    @default("BACKLOG") // BACKLOG | THIS_WEEK | IN_PROGRESS | DONE
  dueDate     DateTime?
  // recurrence: null = one-off. Otherwise DAILY | WEEKLY | BIWEEKLY | MONTHLY.
  // Completing a recurring task spawns the next instance automatically.
  recurrence  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([dueDate])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("operations") // legal | financial | brand | operations | compliance
  url       String // http link (Drive etc.) or local file path — files are not stored in the DB
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  phone     String   @default("")
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Link {
  id        String   @id @default(cuid())
  label     String
  url       String
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ---- v2 structure (schema only, no UI yet) ----

// CRE deal pipeline: lead -> underwriting -> offer -> title -> close
model Deal {
  id        String   @id @default(cuid())
  name      String
  stage     String   @default("LEAD") // LEAD | UNDERWRITING | OFFER | TITLE | CLOSE
  address   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, stage])
}

// Revenue/expense quick-log per business
model LedgerEntry {
  id        String   @id @default(cuid())
  type      String // REVENUE | EXPENSE
  amountCts Int // cents, avoids float drift
  memo      String   @default("")
  date      DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}

// ---- Hookemon University (gear training + certification) ----

// A piece of gear that can be taught. series: FIELD | EP
model HkDevice {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  series    String
  color     String
  oneLiner  String @default("") // who it's for, in one line (sell-it track)
  pairsWith String @default("")
  sortOrder Int    @default(0)

  modules  HkModule[]
  tips     HkTip[]
  ratings  HkRating[]
  badges   HkBadge[]
  homework HkHomework[]
}

// One lesson. track: USE | SELL. level: OPERATOR | PERFORMER | INSTRUCTOR.
// `steps` is filled in by the instructor (exact button sequences, verified on hardware).
model HkModule {
  id        String @id @default(cuid())
  title     String
  track     String
  level     String
  summary   String @default("")
  steps     String @default("")
  sortOrder Int    @default(0)

  deviceId String
  device   HkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, level])
}

model HkTip {
  id   String @id @default(cuid())
  text String

  deviceId String
  device   HkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model HkTrainee {
  id           String   @id @default(cuid())
  name         String
  role         String // RETAIL | SUPPORT | SALES | MARKETING | PRODUCT | OTHER
  tenure       String   @default("")
  musicLevel   String   @default("") // NONE | LITTLE | REGULAR | PERFORMS
  makesWith    String   @default("")
  knownTerms   String   @default("") // comma-separated
  connectivity Int      @default(3) // 1–5 comfort with sync / MIDI / USB
  mostAskedId  String? // device slug customers ask about most
  leastSureId  String? // device slug they feel least confident on
  goal         String   @default("")
  hardQuestion String   @default("")
  notes        String   @default("")
  // post-session
  confBefore   Int?
  confAfter    Int?
  postUseful   String   @default("")
  postUnsure   String   @default("")
  createdAt    DateTime @default(now())

  ratings  HkRating[]
  badges   HkBadge[]
  homework HkHomework[]
}

// Self-rating 0–3. phase: INTAKE | POST
model HkRating {
  id    String @id @default(cuid())
  score Int
  phase String @default("INTAKE")

  traineeId String
  trainee   HkTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  deviceId  String
  device    HkDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([traineeId, deviceId, phase])
}

model HkBadge {
  id        String   @id @default(cuid())
  level     String // OPERATOR | PERFORMER | INSTRUCTOR
  awardedAt DateTime @default(now())

  traineeId String
  trainee   HkTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  deviceId  String
  device    HkDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([traineeId, deviceId, level])
}

// status: ASSIGNED | SUBMITTED | PASSED
model HkHomework {
  id            String    @id @default(cuid())
  template      String
  task          String
  midiFile      String    @default("") // Gearbase file name / link
  status        String    @default("ASSIGNED")
  submissionUrl String    @default("")
  feedback      String    @default("")
  dueDate       DateTime?
  createdAt     DateTime  @default(now())

  traineeId String
  trainee   HkTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  deviceId  String
  device    HkDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([traineeId])
}
