generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A tenant. Every user who signs up gets their own Organization on first
// visit (auto-provisioned from their Clerk user id); all data hangs off it.
model Organization {
  id          String   @id @default(cuid())
  clerkUserId String   @unique // owning Clerk user (one org per user for now)
  name        String   @default("My HQ")
  // Tool slugs (see lib/tools.ts) this org may access. Empty = all tools —
  // this keeps every existing org unaffected until an admin curates it down.
  enabledTools String[] @default([])
  // Custom ordering for the tools page (drag-to-reorder). Empty = default
  // registry order. toolOrder is a flat list of tool slugs; categoryOrder is
  // the order of the category section headers.
  toolOrder     String[] @default([])
  categoryOrder String[] @default([])
  // Tool slugs the user starred; they float to the top of their section.
  favoriteTools String[] @default([])
  // Which home-dashboard template/layout this account uses (see lib/dashboards.ts).
  dashboardTemplate String @default("command-center")
  // Stripe subscription state (see lib/billing.ts).
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String    @default("none") // none | trialing | active | past_due | canceled
  plan                 String    @default("") // starter | growth | full
  currentPeriodEnd     DateTime?
  // No-card free trial: access is granted until this date even with no
  // subscription. Set when the account is first created.
  trialEndsAt          DateTime?
  // Per-account header branding (shown in the top nav).
  brandName    String  @default("")
  brandColor   String  @default("")
  brandLogoUrl String? // small logo as a data URI (resized in-browser)
  // Set once the account finishes the first-run welcome (dashboard pick).
  // Null = brand new → show the welcome screen before the dashboard.
  onboardedAt  DateTime?
  createdAt   DateTime @default(now())

  businesses  Business[]
  usageEvents UsageEvent[]
}

// One row per Claude API call, for per-tenant billing. Written by
// lib/claude.ts (and The Brain's loop) on every AI request.
model UsageEvent {
  id               String   @id @default(cuid())
  tool             String // tool slug, e.g. "the-brain", "content-studio"
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String
  color       String // hex accent color used across cards, tags, calendar dots
  status      String // active | back-burner | launching
  description String
  notes       String   @default("") // markdown scratchpad, autosaved
  brandVoice  String   @default("") // tone/style notes used by the Content Studio tool
  logoUrl     String?  // small square logo, stored as a data URI (resized in-browser)
  website     String   @default("") // primary business website URL
  // Public lead-intake form: token is generated when intake is first
  // enabled; the /intake/[token] URL is only live while intakeEnabled.
  intakeToken   String?  @unique
  intakeEnabled Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tasks         Task[]
  documents     Document[]
  contacts      Contact[]
  links         Link[]
  deals         Deal[]
  ledger        LedgerEntry[]
  contracts     Contract[]
  contentPosts  ContentPost[]
  pipelineItems PipelineItem[]
  invoices      Invoice[]
  testimonials  Testimonial[]
  goals         Goal[]

  // slugs are per-tenant: two orgs can both have "penthouse-yoga"
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  notes       String    @default("")
  priority    String    @default("P2") // P1 | P2 | P3
  status      String    @default("BACKLOG") // BACKLOG | THIS_WEEK | IN_PROGRESS | DONE
  dueDate     DateTime?
  // recurrence: null = one-off. Otherwise DAILY | WEEKLY | BIWEEKLY | MONTHLY.
  // Completing a recurring task spawns the next instance automatically.
  recurrence  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([dueDate])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("operations") // legal | financial | brand | operations | compliance
  url       String // http link (Drive etc.) or local file path — files are not stored in the DB
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  phone     String   @default("")
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Link {
  id        String   @id @default(cuid())
  label     String
  url       String
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ---- v2 structure (schema only, no UI yet) ----

// CRE deal pipeline: lead -> underwriting -> offer -> title -> close.
// Powers the Deal Tracker tool (/tools/deal-tracker).
model Deal {
  id          String    @id @default(cuid())
  name        String
  stage       String    @default("LEAD") // LEAD | UNDERWRITING | OFFER | TITLE | CLOSE
  address     String    @default("")
  askingCts   Int       @default(0) // seller's asking price, cents
  offerCts    Int       @default(0) // our current offer, cents
  contact     String    @default("") // seller / broker / title contact
  targetClose DateTime?
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, stage])
}

// Revenue/expense quick-log per business
model LedgerEntry {
  id        String   @id @default(cuid())
  type      String // REVENUE | EXPENSE
  amountCts Int // cents, avoids float drift
  memo      String   @default("")
  date      DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}

// A planned/produced social post, managed by the Content Calendar tool and
// fed by Content Studio drafts.
model ContentPost {
  id           String    @id @default(cuid())
  title        String
  platform     String    @default("instagram") // instagram | tiktok | youtube | linkedin | x | facebook | pinterest | email | other
  status       String    @default("IDEA") // IDEA | DRAFTED | SCHEDULED | POSTED
  scheduledFor DateTime?
  content      String    @default("") // caption / script body
  hashtags     String    @default("")
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([scheduledFor])
}

// A client engagement or product order moving through the pipeline tracker.
model PipelineItem {
  id        String   @id @default(cuid())
  name      String // client or order name
  kind      String   @default("client") // client | order
  stage     String   @default("LEAD") // LEAD | IN_TALKS | COMMITTED | IN_PROGRESS | DONE
  valueCts  Int      @default(0) // engagement/order value in cents
  contact   String   @default("") // email / phone / handle
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, stage])
}

// An invoice tracked by the Invoice & Payment Tracker tool.
model Invoice {
  id         String    @id @default(cuid())
  client     String // who owes
  amountCts  Int       @default(0)
  status     String    @default("DRAFT") // DRAFT | SENT | PAID
  issuedDate DateTime  @default(now())
  dueDate    DateTime?
  notes      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// A collected review / testimonial from the Testimonial Collector tool.
model Testimonial {
  id        String   @id @default(cuid())
  author    String // who said it
  role      String   @default("") // their title / company
  quote     String   @default("")
  rating    Int      @default(0) // 0 = unrated, else 1-5
  source    String   @default("") // Google, email, DM, etc.
  status    String   @default("REQUESTED") // REQUESTED | RECEIVED | PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// A goal / KPI tracked by the Goals Tracker tool.
model Goal {
  id         String    @id @default(cuid())
  title      String
  targetNum  Float     @default(0)
  currentNum Float     @default(0)
  unit       String    @default("") // $, %, posts, clients, lbs…
  dueDate    DateTime?
  status     String    @default("ACTIVE") // ACTIVE | DONE | ARCHIVED
  notes      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// Tracked agreements from the Contract Manager tool (/tools/contract-manager).
model Contract {
  id                String    @id @default(cuid())
  title             String
  counterparty      String    @default("")
  status            String    @default("active") // draft | active | expired | terminated
  effectiveDate     DateTime?
  endDate           DateTime?
  autoRenews        Boolean   @default(false)
  // Last day to send a non-renewal / termination notice before auto-renewal locks in.
  renewalNoticeDate DateTime?
  summary           String    @default("")
  notes             String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([renewalNoticeDate])
}
