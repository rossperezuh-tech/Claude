generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./venturehq.db"
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  color       String // hex accent color used across cards, tags, calendar dots
  status      String // active | back-burner | launching
  description String
  notes       String   @default("") // markdown scratchpad, autosaved
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks     Task[]
  documents Document[]
  contacts  Contact[]
  links     Link[]
  deals     Deal[]
  ledger    LedgerEntry[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  notes       String    @default("")
  priority    String    @default("P2") // P1 | P2 | P3
  status      String    @default("BACKLOG") // BACKLOG | THIS_WEEK | IN_PROGRESS | DONE
  dueDate     DateTime?
  // recurrence: null = one-off. Otherwise DAILY | WEEKLY | BIWEEKLY | MONTHLY.
  // Completing a recurring task spawns the next instance automatically.
  recurrence  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([dueDate])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("operations") // legal | financial | brand | operations | compliance
  url       String // http link (Drive etc.) or local file path — files are not stored in the DB
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // set when the document belongs to one CRE deal
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([businessId, category])
  @@index([dealId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  phone     String   @default("")
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Link {
  id        String   @id @default(cuid())
  label     String
  url       String
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ---- CRE deal pipeline ----

// lead -> underwriting -> offer -> title -> close (or dead)
model Deal {
  id      String @id @default(cuid())
  name    String
  stage   String @default("LEAD") // LEAD | UNDERWRITING | OFFER | TITLE | CLOSE | DEAD
  address String @default("")
  city    String @default("")
  state   String @default("")

  propertyType String @default("warehouse") // warehouse | flex | manufacturing | land | retail | office | other
  buildingSf   Int?
  landAcres    Float?
  yearBuilt    Int?

  source   String @default("") // website | mail | call | broker | referral | other
  strategy String @default("BUY_HOLD") // BUY_HOLD | WHOLESALE

  sellerName  String @default("")
  sellerPhone String @default("")
  sellerEmail String @default("")
  motivation  String @default("")

  // whole dollars
  askingPrice   Int?
  offerPrice    Int? // what you offered or plan to offer
  contractPrice Int?

  nextAction     String    @default("")
  nextActionDate DateTime?
  closingDate    DateTime?
  lostReason     String    @default("")

  underwriting String @default("") // JSON: lib/underwriting Inputs
  loi          String @default("") // JSON: lib/loi LoiTerms
  notes        String @default("")

  stageChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  documents Document[]
  activity  DealActivity[]

  @@index([businessId, stage])
}

// Timeline per deal: notes, calls, stage moves, offers
model DealActivity {
  id        String   @id @default(cuid())
  kind      String   @default("NOTE") // NOTE | CALL | STAGE | OFFER | SYSTEM
  body      String
  createdAt DateTime @default(now())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

// ---- v2 structure (schema only, no UI yet) ----

// Revenue/expense quick-log per business
model LedgerEntry {
  id        String   @id @default(cuid())
  type      String // REVENUE | EXPENSE
  amountCts Int // cents, avoids float drift
  memo      String   @default("")
  date      DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}
