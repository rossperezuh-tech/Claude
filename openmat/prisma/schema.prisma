generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Coaches and gyms have accounts. Clients book as guests (name + email).
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        // COACH | GYM
  createdAt    DateTime      @default(now())
  coachProfile CoachProfile?
  gymProfile   GymProfile?
}

model CoachProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  displayName     String
  discipline      String           // Muay Thai, Boxing, BJJ, Wrestling, MMA
  bio             String
  borough         String           // Staten Island, Brooklyn, Queens, Manhattan, Bronx
  yearsExperience Int
  accolades       String?
  stripeAccountId String?          // Stripe Connect Express account for payouts
  partnerships    Partnership[]
  listings        SessionListing[]
}

model GymProfile {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id])
  gymName       String
  address       String
  borough       String
  description   String
  amenities     String           // comma-separated
  spaceSharePct Int              @default(20) // gym's % cut of sessions hosted there
  stripeAccountId String?        // Stripe Connect Express account for payouts
  partnerships  Partnership[]
  listings      SessionListing[]
}

// A coach's approved (or pending) relationship with a gym.
model Partnership {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id])
  gymId     String
  gym       GymProfile   @relation(fields: [gymId], references: [id])
  status    String       @default("PENDING") // PENDING | APPROVED | DECLINED
  message   String?
  createdAt DateTime     @default(now())

  @@unique([coachId, gymId])
}

// A bookable session a coach runs at a partner gym.
model SessionListing {
  id          String       @id @default(cuid())
  coachId     String
  coach       CoachProfile @relation(fields: [coachId], references: [id])
  gymId       String
  gym         GymProfile   @relation(fields: [gymId], references: [id])
  title       String
  description String
  discipline  String
  date        String       // YYYY-MM-DD
  startTime   String       // "HH:MM"
  endTime     String
  priceCents  Int
  capacity    Int
  status      String       @default("OPEN") // OPEN | CANCELLED
  createdAt   DateTime     @default(now())
  bookings    Booking[]

  @@index([date, gymId])
  @@index([coachId, date])
}

// A client's paid spot in a session. The split is locked in at booking time.
model Booking {
  id               String         @id @default(cuid())
  listingId        String
  listing          SessionListing @relation(fields: [listingId], references: [id])
  clientName       String
  clientEmail      String
  priceCents       Int
  platformFeeCents Int            // your cut
  gymCutCents      Int            // gym's space share
  coachNetCents    Int            // what the coach earns
  status           String         @default("pending_payment") // pending_payment | confirmed | cancelled
  stripeSessionId  String?        @unique
  // Stripe Connect payout tracking. "manual" = pay out by hand; "transferred"
  // = both transfers sent; "partial" = one recipient wasn't connected yet.
  payoutStatus     String         @default("manual")
  coachTransferId  String?
  gymTransferId    String?
  createdAt        DateTime       @default(now())

  @@unique([listingId, clientEmail])
  @@index([listingId])
}
