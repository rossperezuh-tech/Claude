# SQLite database (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Secret used to sign login session cookies — set a long random string in production
SESSION_SECRET="change-me-to-a-long-random-string"

# Stripe — leave blank to run in demo mode (bookings confirm without payment)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public base URL used for Stripe redirect URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin password for /admin (platform earnings view)
ADMIN_PASSWORD="changeme"
