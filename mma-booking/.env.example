# SQLite database (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Stripe — leave blank to run in demo mode (bookings confirm without payment).
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Optional: only needed if you configure a webhook endpoint pointing at /api/webhook
STRIPE_WEBHOOK_SECRET=""

# Public base URL used for Stripe redirect URLs (falls back to request origin)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin password for /admin (instructor bookings view)
# Set this to protect the bookings page in production
ADMIN_PASSWORD="changeme"
