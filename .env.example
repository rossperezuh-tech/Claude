# Postgres connection strings.
# On Vercel: create a Postgres database via the Neon integration (Storage tab -> Neon),
# and Vercel auto-injects DATABASE_URL and DATABASE_URL_UNPOOLED into the project.
# Locally, or with another provider, set both by hand:
#   DATABASE_URL          = pooled connection string (used at runtime)
#   DATABASE_URL_UNPOOLED = direct (non-pooled) connection string (used for migrations)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname

# Claude API key for the Steadyhand tools (/tools) — get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Clerk authentication — get both from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
