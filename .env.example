# Copy to .env and fill in.

# Postgres. Locally: a Postgres you run yourself, or a free Neon database.
# On Vercel, connecting Neon sets both of these for you.
DATABASE_URL="postgresql://vhq:vhq@localhost:5432/venturehq"
DATABASE_URL_UNPOOLED="postgresql://vhq:vhq@localhost:5432/venturehq"

# The password for signing in. Required when deployed; at least 12 characters.
# Leave blank locally to skip the sign-in page.
APP_PASSWORD=""

# Optional. Change it to sign out every device.
AUTH_SECRET=""

# Optional. If set, website forms must post to /api/leads?key=<this value>.
LEAD_WEBHOOK_SECRET=""
