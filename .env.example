# Postgres connection strings.
# On Vercel: create a Postgres database (Storage tab -> Postgres, powered by Neon),
# and Vercel will inject these automatically when you link the project.
# Locally, or with another provider (Neon, Supabase, Railway), set both by hand:
#   DATABASE_URL  = pooled connection string (used at runtime, add ?pgbouncer=true if needed)
#   DIRECT_URL    = direct (non-pooled) connection string (used for migrations)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Claude API key for the Steadyhand tools (/tools) — get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
